PROJECT_NAME="Student Management System"
ENVIRONMENT="development"
SECRET_KEY="supersecretjwtkeyforstudentmanagementsystemchangethisinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - SQLite (Local development only; resets on cloud deploys)
# DATABASE_URL="sqlite:///./sms.db"
#
# Production Database - Managed Cloud PostgreSQL (Supabase / Neon / Render)
# Required for permanent data storage in production deployments!
DATABASE_URL="postgresql://username:password@ep-host.neon.tech/dbname?sslmode=require"

# Minimum attendance threshold (%)
MIN_ATTENDANCE_THRESHOLD=75.0

# CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Uploads directory
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
